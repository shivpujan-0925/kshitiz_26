# Environment & Server
NODE_ENV=production
PORT=5000

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/astra26?retryWrites=true&w=majority

# Security & Authentication (Change these in production!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_secret_password_2026
JWT_SECRET=generate_a_random_64_character_hex_secret_key_here

# CORS & Domain Configuration
FRONTEND_URL=https://astra26.vercel.app
ALLOWED_ORIGINS=https://astra26.vercel.app,http://localhost:5173

# Cloudinary Storage (Optional - Fallback to secure local drive uploads)
CLOUDINARY_CLOUD_NAME=astra26_cloud
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
